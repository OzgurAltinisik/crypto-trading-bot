# --- Web ---
# Domain for HTTPS (Caddy gets the certificate automatically).
# Without a domain use <server-ip>.sslip.io, e.g. 203.0.113.10.sslip.io
DOMAIN=panel.example.com
# Public address of the site: used in e-mail / Telegram links.
PUBLIC_URL=https://panel.example.com
# Empty = public site (anyone can view and subscribe).
# Set a long random value to make it invite-only: https://<DOMAIN>/?key=<DASHBOARD_KEY>
DASHBOARD_KEY=
# Shown on the privacy page for data requests (optional).
CONTACT_EMAIL=

# --- E-mail alerts (any SMTP provider) ---
# Without a domain: a dedicated Gmail account + app password (~500 mails/day):
#   SMTP_HOST=smtp.gmail.com  SMTP_PORT=587  SMTP_USER=you.alerts@gmail.com
#   SMTP_PASSWORD=<16-char app password>  MAIL_FROM=you.alerts@gmail.com
# With a domain later: Brevo (smtp-relay.brevo.com), Resend (smtp.resend.com), ...
# Leave SMTP_HOST empty to disable e-mail sign-ups.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=Kripto Sinyal

# --- Telegram ---
# Token from @BotFather, and the bot's username (without @) for the website link.
TELEGRAM_TOKEN=your_bot_token_here
TELEGRAM_BOT_USERNAME=
# Optional: a channel/group/chat that receives every signal (@channel_name, -100..., or your chat id).
TELEGRAM_CHAT_ID=
# 1 (default) = anyone can use the bot and /abone. 0 = only TELEGRAM_CHAT_ID / TELEGRAM_ALLOWED_CHATS.
TELEGRAM_PUBLIC=1
TELEGRAM_ALLOWED_CHATS=
